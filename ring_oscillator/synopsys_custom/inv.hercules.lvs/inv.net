{NETLIST inv
{VERSION 1 0 0}

/* Level 0 */

{CELL inv
	{PORT vdd! out gnd! in}
	{PROP top=0.775000 bottom=-2.615000 left=-3.965000 right=-2.585000}
	{INST M1=N {PROP x=-3.105 y=-1.430  l=0.140 w=0.200}
		{PIN in=GATE out=SRC gnd!=DRN gnd!=BULK }}
	{INST M2=P {PROP x=-3.105 y=-0.620  l=0.140 w=0.450}
		{PIN in=GATE out=SRC vdd!=DRN vdd!=BULK }}
}
}
