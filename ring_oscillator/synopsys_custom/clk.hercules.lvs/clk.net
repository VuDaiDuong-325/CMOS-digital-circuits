{NETLIST clk
{VERSION 1 0 0}

/* Level 0 */

{CELL clk
	{PORT gnd! vdd! clk}
	{PROP top=1.115000 bottom=-1.850000 left=-8.435000 right=-4.455000}
	{INST M1=N {PROP x=-5.135 y=-0.965  l=0.130 w=0.200}
		{PIN N_5=GATE clk=SRC gnd!=DRN N_38=BULK }}
	{INST M2=N {PROP x=-6.455 y=-0.965  l=0.130 w=0.200}
		{PIN N_2=GATE N_5=SRC gnd!=DRN N_38=BULK }}
	{INST M3=N {PROP x=-7.775 y=-0.965  l=0.130 w=0.200}
		{PIN clk=GATE N_2=SRC gnd!=DRN N_38=BULK }}
	{INST M4=P {PROP x=-5.135 y=0.250  l=0.130 w=0.450}
		{PIN N_5=GATE clk=SRC vdd!=DRN N_40=BULK }}
	{INST M5=P {PROP x=-6.455 y=0.250  l=0.130 w=0.450}
		{PIN N_2=GATE N_5=SRC vdd!=DRN N_40=BULK }}
	{INST M6=P {PROP x=-7.775 y=0.250  l=0.130 w=0.450}
		{PIN clk=GATE N_2=SRC vdd!=DRN N_40=BULK }}
}
}
