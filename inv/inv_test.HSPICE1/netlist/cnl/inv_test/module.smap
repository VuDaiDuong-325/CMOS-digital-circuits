<module name="switched: inv inv_test schematic vl: schematic hspice symbol sl: symbol">
<scope name="Instance">
<forward>
<mapping dst="xi1" src="I1"/>
</forward>
<reverse>
<mapping dst="I1" src="xi1"/>
</reverse>
</scope>
<scope name="Net">
<forward/>
<reverse/>
</scope>
<scope name="Terminal">
<forward>
<mapping dst="in out" src="&lt;unmappedTermOrder>"/>
<mapping dst="in out" src="&lt;termOrder>"/>
</forward>
<reverse>
<mapping dst="&lt;unmappedTermOrder>" src="in out"/>
</reverse>
</scope>
<master_instances>
<instance_header master="inv">
<instance name="I1"/>
</instance_header>
</master_instances>
</module>
