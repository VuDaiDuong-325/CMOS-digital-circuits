<module name="switched: analogLib pcapacitor hspice">
<scope name="Terminal">
<forward>
<mapping dst="plus_1 (FUNCTION\ minus(root(&quot;PLUS&quot;)))" src="&lt;termOrder>"/>
<mapping dst="PLUS MINUS" src="&lt;unmappedTermOrder>"/>
<mapping dst="(FUNCTION\ minus(root(&quot;PLUS&quot;)))" src="MINUS"/>
<mapping dst="plus_1" src="PLUS"/>
</forward>
<reverse>
<mapping dst="MINUS" src="(FUNCTION\ minus(root(&quot;PLUS&quot;)))"/>
<mapping dst="PLUS" src=""/>
<mapping dst="&lt;unmappedTermOrder>" src="PLUS MINUS"/>
<mapping dst="&lt;termOrder>" src="plus_1 (FUNCTION\ minus(root(&quot;PLUS&quot;)))"/>
<mapping dst="&lt;termOrder>" src="plus minus"/>
<mapping dst="PLUS" src="plus_1"/>
<mapping dst="MINUS" src="minus"/>
<mapping dst="PLUS" src="plus"/>
</reverse>
</scope>
<master_instances/>
</module>
