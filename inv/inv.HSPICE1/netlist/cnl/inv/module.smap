<module name="vsl: inv inv schematic vl: hspice hspiceD cmos.sch cmos_sch schematic veriloga">
<scope name="Instance">
<forward>
<mapping dst="m3" src="M3"/>
<mapping dst="m2" src="M2"/>
</forward>
<reverse>
<mapping dst="M3" src="m3"/>
<mapping dst="M2" src="m2"/>
</reverse>
</scope>
<scope name="Net">
<forward/>
<reverse/>
</scope>
<scope name="Terminal">
<forward>
<mapping dst="in out" src="&lt;unmappedTermOrder>"/>
<mapping dst="in out" src="&lt;termOrder>"/>
</forward>
<reverse>
<mapping dst="&lt;unmappedTermOrder>" src="in out"/>
</reverse>
</scope>
<master_instances>
<instance_header master="n_4t">
<instance name="M3"/>
</instance_header>
<instance_header master="p_4t">
<instance name="M2"/>
</instance_header>
</master_instances>
</module>
