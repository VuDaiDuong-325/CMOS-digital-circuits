<module name="vsl: full_adder_2b full_adder schematic vl: hspice hspiceD cmos.sch cmos_sch schematic veriloga">
<scope name="Instance">
<forward>
<mapping dst="xi0" src="I0"/>
<mapping dst="xi2" src="I2"/>
<mapping dst="xi5" src="I5"/>
<mapping dst="xi3" src="I3"/>
<mapping dst="xi4" src="I4"/>
<mapping dst="xi6" src="I6"/>
<mapping dst="xi7" src="I7"/>
<mapping dst="xi1" src="I1"/>
<mapping dst="xi8" src="I8"/>
</forward>
<reverse>
<mapping dst="I6" src="xi6"/>
<mapping dst="I4" src="xi4"/>
<mapping dst="I2" src="xi2"/>
<mapping dst="I3" src="xi3"/>
<mapping dst="I5" src="xi5"/>
<mapping dst="I1" src="xi1"/>
<mapping dst="I0" src="xi0"/>
<mapping dst="I7" src="xi7"/>
<mapping dst="I8" src="xi8"/>
</reverse>
</scope>
<scope name="Net">
<forward>
<mapping dst="s" src="S"/>
<mapping dst="b" src="B"/>
<mapping dst="cin" src="Cin"/>
<mapping dst="cout" src="Cout"/>
<mapping dst="a" src="A"/>
</forward>
<reverse>
<mapping dst="S" src="s"/>
<mapping dst="Cin" src="cin"/>
<mapping dst="Cout" src="cout"/>
<mapping dst="A" src="a"/>
<mapping dst="B" src="b"/>
</reverse>
</scope>
<scope name="Terminal">
<forward>
<mapping dst="A B Cin Cout S" src="&lt;unmappedTermOrder>"/>
<mapping dst="a b cin cout s" src="&lt;termOrder>"/>
<mapping dst="s" src="S"/>
<mapping dst="b" src="B"/>
<mapping dst="cin" src="Cin"/>
<mapping dst="cout" src="Cout"/>
<mapping dst="a" src="A"/>
</forward>
<reverse>
<mapping dst="&lt;unmappedTermOrder>" src="A B Cin Cout S"/>
<mapping dst="&lt;termOrder>" src="a b cin cout s"/>
<mapping dst="S" src="s"/>
<mapping dst="Cin" src="cin"/>
<mapping dst="Cout" src="cout"/>
<mapping dst="A" src="a"/>
<mapping dst="B" src="b"/>
</reverse>
</scope>
<master_instances>
<instance_header master="nand2">
<instance name="I0"/>
<instance name="I1"/>
<instance name="I2"/>
<instance name="I3"/>
<instance name="I4"/>
<instance name="I5"/>
<instance name="I6"/>
<instance name="I7"/>
<instance name="I8"/>
</instance_header>
</master_instances>
</module>
