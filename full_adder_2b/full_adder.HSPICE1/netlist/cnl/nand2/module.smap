<module name="vsl: nand2 nand2 schematic vl: hspice hspiceD cmos.sch cmos_sch schematic veriloga">
<scope name="Instance">
<forward>
<mapping dst="m1" src="M1"/>
<mapping dst="m3" src="M3"/>
<mapping dst="m0" src="M0"/>
<mapping dst="m2" src="M2"/>
</forward>
<reverse>
<mapping dst="M0" src="m0"/>
<mapping dst="M1" src="m1"/>
<mapping dst="M3" src="m3"/>
<mapping dst="M2" src="m2"/>
</reverse>
</scope>
<scope name="Net">
<forward>
<mapping dst="a" src="A"/>
<mapping dst="b" src="B"/>
<mapping dst="y" src="Y"/>
</forward>
<reverse>
<mapping dst="B" src="b"/>
<mapping dst="A" src="a"/>
<mapping dst="Y" src="y"/>
</reverse>
</scope>
<scope name="Terminal">
<forward>
<mapping dst="a" src="A"/>
<mapping dst="b" src="B"/>
<mapping dst="a b y" src="&lt;termOrder>"/>
<mapping dst="y" src="Y"/>
<mapping dst="A B Y" src="&lt;unmappedTermOrder>"/>
</forward>
<reverse>
<mapping dst="A" src="a"/>
<mapping dst="B" src="b"/>
<mapping dst="&lt;termOrder>" src="a b y"/>
<mapping dst="Y" src="y"/>
<mapping dst="&lt;unmappedTermOrder>" src="A B Y"/>
</reverse>
</scope>
<master_instances>
<instance_header master="n_4t">
<instance name="M0"/>
<instance name="M1"/>
</instance_header>
<instance_header master="p_4t">
<instance name="M2"/>
<instance name="M3"/>
</instance_header>
</master_instances>
</module>
