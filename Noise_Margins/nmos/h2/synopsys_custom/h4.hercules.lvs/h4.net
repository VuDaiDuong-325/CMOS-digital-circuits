{NETLIST h4
{VERSION 1 0 0}

/* Level 1 */

{CELL n_3t
	{PORT N_2 N_3 N_4 N_10}
	{PROP top=2.130000 bottom=-0.470000 left=-0.350000 right=0.450000}
	{INST M1=N {PROP x=0.050 y=1.000  l=0.100 w=2.000}
		{PIN N_10=GATE N_3=SRC N_2=DRN N_4=BULK }}
}

/* Level 0 */

{CELL h4
	{PORT vdd! gnd! out}
	{PROP top=2.330000 bottom=-1.495000 left=-1.620000 right=0.010000}
	{INST I1=n_3t {PROP x=-0.445 y=-0.755 angle=0 reflection=0}
		{PIN out=N_2 vdd!=N_3 gnd!=N_4 N_4=N_10}}
	{INST I0=n_3t {PROP x=-1.245 y=-0.755 angle=0 reflection=0}
		{PIN N_4=N_2 vdd!=N_3 gnd!=N_4 vdd!=N_10}}
}
}
