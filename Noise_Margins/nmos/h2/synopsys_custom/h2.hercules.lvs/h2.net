{NETLIST h2
{VERSION 1 0 0}

/* Level 1 */

{CELL n_3t
	{PORT N_2 N_3 N_4 N_10}
	{PROP top=2.130000 bottom=-0.470000 left=-0.350000 right=0.450000}
	{INST M1=N {PROP x=0.050 y=1.000  l=0.100 w=2.000}
		{PIN N_10=GATE N_3=SRC N_2=DRN N_4=BULK }}
}

/* Level 0 */

{CELL h2
	{PORT gnd! vdd! out}
	{PROP top=2.785000 bottom=-0.535000 left=-1.170000 right=1.235000}
	{INST I2=n_3t {PROP x=0.780 y=0.215 angle=0 reflection=0}
		{PIN out=N_2 N_3=N_3 gnd!=N_4 vdd!=N_10}}
	{INST I1=n_3t {PROP x=-0.020 y=0.215 angle=0 reflection=0}
		{PIN N_3=N_2 N_5=N_3 gnd!=N_4 vdd!=N_10}}
	{INST I0=n_3t {PROP x=-0.820 y=0.215 angle=0 reflection=0}
		{PIN N_5=N_2 vdd!=N_3 gnd!=N_4 vdd!=N_10}}
}
}
