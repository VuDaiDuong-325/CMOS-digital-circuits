{NETLIST h2
{VERSION 1 0 0}

{CELL h2
    {PORT vdd! out }
    {INST MM2=N {PROP n="N" Length=0.1 Width=2 Mult=1 }
	{PIN vdd!=GATE out=SRC net13=DRN }}
    {INST MM1=N {PROP n="N" Length=0.1 Width=2 Mult=1 }
	{PIN vdd!=GATE net13=SRC net12=DRN }}
    {INST MM0=N {PROP n="N" Length=0.1 Width=2 Mult=1 }
	{PIN vdd!=GATE net12=SRC vdd!=DRN }}
}
}
