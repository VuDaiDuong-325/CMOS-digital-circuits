<module name="vsl: dff dff schematic vl: hspice hspiceD cmos.sch cmos_sch schematic veriloga">
<scope name="Instance">
<forward>
<mapping dst="xi21" src="I21"/>
<mapping dst="xi20" src="I20"/>
<mapping dst="xi23" src="I23"/>
<mapping dst="xi22" src="I22"/>
<mapping dst="xi15" src="I15"/>
<mapping dst="xi19" src="I19"/>
<mapping dst="xi17" src="I17"/>
<mapping dst="xi16" src="I16"/>
<mapping dst="xi18" src="I18"/>
</forward>
<reverse>
<mapping dst="I23" src="xi23"/>
<mapping dst="I22" src="xi22"/>
<mapping dst="I20" src="xi20"/>
<mapping dst="I15" src="xi15"/>
<mapping dst="I16" src="xi16"/>
<mapping dst="I17" src="xi17"/>
<mapping dst="I19" src="xi19"/>
<mapping dst="I21" src="xi21"/>
<mapping dst="I18" src="xi18"/>
</reverse>
</scope>
<scope name="Net">
<forward>
<mapping dst="q" src="Q"/>
<mapping dst="d" src="D"/>
</forward>
<reverse>
<mapping dst="Q" src="q"/>
<mapping dst="D" src="d"/>
</reverse>
</scope>
<scope name="Terminal">
<forward>
<mapping dst="CLK D Q" src="&lt;unmappedTermOrder>"/>
<mapping dst="clk d q" src="&lt;termOrder>"/>
<mapping dst="q" src="Q"/>
<mapping dst="d" src="D"/>
<mapping dst="clk" src="CLK"/>
</forward>
<reverse>
<mapping dst="&lt;termOrder>" src="clk d q"/>
<mapping dst="&lt;unmappedTermOrder>" src="CLK D Q"/>
<mapping dst="Q" src="q"/>
<mapping dst="D" src="d"/>
<mapping dst="CLK" src="clk"/>
</reverse>
</scope>
<master_instances>
<instance_header master="inv">
<instance name="I15"/>
<instance name="I20"/>
<instance name="I21"/>
<instance name="I22"/>
<instance name="I23"/>
</instance_header>
<instance_header master="tg">
<instance name="I16"/>
<instance name="I17"/>
<instance name="I18"/>
<instance name="I19"/>
</instance_header>
</master_instances>
</module>
