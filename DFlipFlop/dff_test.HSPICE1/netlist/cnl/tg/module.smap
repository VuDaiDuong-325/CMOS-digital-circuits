<module name="vsl: tg tg schematic vl: hspice hspiceD cmos.sch cmos_sch schematic veriloga">
<scope name="Instance">
<forward>
<mapping dst="m1" src="M1"/>
<mapping dst="m0" src="M0"/>
</forward>
<reverse>
<mapping dst="M1" src="m1"/>
<mapping dst="M0" src="m0"/>
</reverse>
</scope>
<scope name="Net">
<forward/>
<reverse/>
</scope>
<scope name="Terminal">
<forward>
<mapping dst="clk clkb in out" src="&lt;unmappedTermOrder>"/>
<mapping dst="clk clkb in out" src="&lt;termOrder>"/>
</forward>
<reverse>
<mapping dst="&lt;unmappedTermOrder>" src="clk clkb in out"/>
</reverse>
</scope>
<master_instances>
<instance_header master="n_4t">
<instance name="M1"/>
</instance_header>
<instance_header master="p_4t">
<instance name="M0"/>
</instance_header>
</master_instances>
</module>
