{NETLIST dff
{VERSION 1 0 0}

{CELL dff
    {PORT vdd! gnd! renamed CLK Q D }
    {INST XI16/MM1=N {PROP n="tg/N" Length=0.1 Width=0.36 Mult=1 }
	{PIN clkb=GATE net69=SRC D=DRN }}
    {INST XI19/MM0=P {PROP n="tg/P" Length=0.1 Width=0.72 Mult=1 }
	{PIN clkb=GATE net75=SRC net80=DRN }}
    {INST XI18/MM0=P {PROP n="tg/P" Length=0.1 Width=0.72 Mult=1 }
	{PIN CLK=GATE renamed=SRC net75=DRN }}
    {INST XI19/MM1=N {PROP n="tg/N" Length=0.1 Width=0.36 Mult=1 }
	{PIN CLK=GATE net75=SRC net80=DRN }}
    {INST XI18/MM1=N {PROP n="tg/N" Length=0.1 Width=0.36 Mult=1 }
	{PIN clkb=GATE renamed=SRC net75=DRN }}
    {INST XI15/MM2=P {PROP n="inv/P" Length=0.1 Width=0.72 Mult=1 }
	{PIN CLK=GATE vdd!=SRC clkb=DRN }}
    {INST XI22/MM2=P {PROP n="inv/P" Length=0.1 Width=0.72 Mult=1 }
	{PIN Q=GATE vdd!=SRC renamed=DRN }}
    {INST XI21/MM2=P {PROP n="inv/P" Length=0.1 Width=0.72 Mult=1 }
	{PIN net80=GATE vdd!=SRC net81=DRN }}
    {INST XI20/MM2=P {PROP n="inv/P" Length=0.1 Width=0.72 Mult=1 }
	{PIN net69=GATE vdd!=SRC net80=DRN }}
    {INST XI23/MM2=P {PROP n="inv/P" Length=0.1 Width=0.72 Mult=1 }
	{PIN net75=GATE vdd!=SRC Q=DRN }}
    {INST XI17/MM0=P {PROP n="tg/P" Length=0.1 Width=0.72 Mult=1 }
	{PIN clkb=GATE net81=SRC net69=DRN }}
    {INST XI15/MM3=N {PROP n="inv/N" Length=0.1 Width=0.36 Mult=1 }
	{PIN CLK=GATE gnd!=SRC clkb=DRN }}
    {INST XI22/MM3=N {PROP n="inv/N" Length=0.1 Width=0.36 Mult=1 }
	{PIN Q=GATE gnd!=SRC renamed=DRN }}
    {INST XI21/MM3=N {PROP n="inv/N" Length=0.1 Width=0.36 Mult=1 }
	{PIN net80=GATE gnd!=SRC net81=DRN }}
    {INST XI20/MM3=N {PROP n="inv/N" Length=0.1 Width=0.36 Mult=1 }
	{PIN net69=GATE gnd!=SRC net80=DRN }}
    {INST XI23/MM3=N {PROP n="inv/N" Length=0.1 Width=0.36 Mult=1 }
	{PIN net75=GATE gnd!=SRC Q=DRN }}
    {INST XI17/MM1=N {PROP n="tg/N" Length=0.1 Width=0.36 Mult=1 }
	{PIN CLK=GATE net81=SRC net69=DRN }}
    {INST XI16/MM0=P {PROP n="tg/P" Length=0.1 Width=0.72 Mult=1 }
	{PIN CLK=GATE net69=SRC D=DRN }}
}
}
